# ============================================
# Doc-AI2 Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it is in .gitignore
# ============================================

# --------------------------------------------
# Neo4j Graph Database
# --------------------------------------------
# For production, use neo4j+s:// (encrypted) or neo4j+ssc:// (with cert verification)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_CONNECTION_RETRY_ATTEMPTS=3
NEO4J_CONNECTION_RETRY_DELAY=1

# --------------------------------------------
# Qdrant Vector Database
# --------------------------------------------
QDRANT_URI=localhost:6333
QDRANT_API_KEY=<CHANGE_ME_API_KEY>
QDRANT_COLLECTION=markdown_embeddings
VECTOR_SIZE=768
DISTANCE_METRIC=Cosine

# --------------------------------------------
# LLM Server (Ollama / vLLM / llama.cpp)
# --------------------------------------------
# For production, consider using https:// instead of http://
LLM_SERVER_URL=http://localhost:8080
LLM_MODEL=Qwen3.6-27B-MTP-GGUF
LLM_TEMPERATURE=0.0
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# --------------------------------------------
# Embedding Model
# --------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EXTERNAL_EMBEDDING_API_URL=http://localhost:7700/v1

# --------------------------------------------
# OpenAI API (for Marker LLM mode)
# --------------------------------------------
OPENAI_API_KEY=<CHANGE_ME_OPENAI_KEY>

# --------------------------------------------
# Redis (Rate Limiting)
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<OPTIONAL_REDIS_PASSWORD>
REDIS_DB=0
REDIS_SSL=false
USE_REDIS_RATE_LIMITING=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------------------------
# Microservice
# --------------------------------------------
MICROSERVICE_HOST=localhost
MICROSERVICE_PORT=8080
MAX_UPLOAD_SIZE_MB=100
MICROSERVICE_TIMEOUT=300
ENABLE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# --------------------------------------------
# API Security
# --------------------------------------------
API_KEY=<CHANGE_ME_API_KEY>
CORS_ORIGINS=http://localhost:3000

# --------------------------------------------
# Graph Search
# --------------------------------------------
SEARCH_TOP_K=3
SEARCH_MAX_HOPS=2
SEARCH_TIMEOUT=30
GRAPH_MAX_HOPS=2
GRAPH_MAX_NODES=100
GRAPH_RELATIONSHIP_THRESHOLD=0.5

# --------------------------------------------
# Hybrid Search Weights
# --------------------------------------------
GRAPH_WEIGHT=0.5
VECTOR_WEIGHT=0.5
SEARCH_LIMIT=10
MIN_SCORE_THRESHOLD=0.3

# --------------------------------------------
# Chunking
# --------------------------------------------
VECTOR_DB_CHUNK_SIZE=500
CHUNK_OVERLAP_RATIO=0.15
CHUNK_OVERLAP_CHARS=75
CHUNK_MODE=character
SEMANTIC_SIMILARITY_THRESHOLD=0.6

# --------------------------------------------
# Domain Detection
# --------------------------------------------
DOMAIN_DETECTION_MODE=auto

# --------------------------------------------
# Vector Backend Selection
# --------------------------------------------
# Options: qdrant, neo4j, dual
VECTOR_BACKEND=qdrant

# --------------------------------------------
# VRAM Management
# --------------------------------------------
VRAM_SEQUENTIAL_MODE=true
VRAM_SAFE_LIMIT_GB=22
VRAM_LOAD_TIMEOUT=300
VRAM_UNLOAD_TIMEOUT=60

# --------------------------------------------
# Parallel Processing
# --------------------------------------------
PARALLEL_PROCESSING=true
PARALLEL_MAX_WORKERS=0
USE_PROCESS_POOL=auto
PARALLEL_CHUNK_BATCH_SIZE=10

# --------------------------------------------
# Logging & Monitoring
# --------------------------------------------
LOG_LEVEL=INFO
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# --------------------------------------------
# Processing Limits
# --------------------------------------------
DOC_AI_MAX_FILE_SIZE_MB=500
DOC_AI_INSTRUCTION=จงสรุปและวิเคราะห์ข้อมูลจากเนื้อหาต่อไปนี้
